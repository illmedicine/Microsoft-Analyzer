# --- MA-365 server configuration ---
PORT=8787
PUBLIC_URL=http://localhost:5173

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web")
GOOGLE_CLIENT_ID=

# 32-byte key (base64) used to encrypt tenant refresh tokens at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# Microsoft Entra app registration used for "Connect my tenant" (delegated, read-only scopes)
# Redirect URI to register: <PUBLIC_URL>/api/tenant/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Local development only — enables /api/auth/dev without Google. NEVER set in production.
ALLOW_DEV_LOGIN=0
